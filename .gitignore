# ==============================================================================
# Controle - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secrets (NUNCA comitar credenciais reais)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development
.env.test
.env.production
.env.staging
.env.*.local
*.env

# Manter exemplos de configuração seguros
!.env.example
!.env.*.example

# Chaves, Certificados e Credenciais
*.pem
*.key
*.pub
*.pfx
*.p12
*.cer
*.crt
*.der
deploy_key*
credentials.json
id_rsa*
id_ed25519*

# ------------------------------------------------------------------------------
# Backend & JVM (Kotlin / Java / Maven)
# ------------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle (caso venha a ser utilizado)
.gradle/
build/
**/build/

# ------------------------------------------------------------------------------
# Frontend (Node.js / React / Vite / TypeScript)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.tsbuildinfo

# Logs de gerenciadores de pacotes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testes & Cobertura
coverage/
**/coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# Python (scripts de migração / automação)
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.coverage

# ------------------------------------------------------------------------------
# IDEs & Editores de Código
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, WebStorm, etc.)
.idea/
**/.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/compose-spec.json
*.code-workspace

# Outros editores
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Docker & Deploy Local
# ------------------------------------------------------------------------------
docker-compose.override.yml
.migration_completed
*.dump
*.sql.gz

# ------------------------------------------------------------------------------
# Logs e Arquivos Temporários
# ------------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.bak

# ------------------------------------------------------------------------------
# Sistema Operacional
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Assistentes de IA, Worktrees & Ferramentas
# ------------------------------------------------------------------------------
.kilo/
.gemini/
scratch/