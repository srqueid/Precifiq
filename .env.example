# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - EXEMPLO
# Copie este arquivo para .env e preencha com os valores do seu ambiente:
# cp .env.example .env
# ==============================================================================

# --- BANCO DE DADOS (PostgreSQL / NeonDB) ---
# Para PostgreSQL Local (Docker Compose na VPS):
#   DB_HOST=postgres
#   DB_PORT=5432
#   DB_NAME=precifiq_db
#   DB_USER=precifiq_user
#   DB_PASSWORD=sua_senha_segura
#   DB_SSLMODE=disable
#
# Para NeonDB (Nuvem / AWS):
#   DB_HOST=ep-seu-endpoint.us-east-1.aws.neon.tech
#   DB_PORT=5432
#   DB_NAME=neondb
#   DB_USER=neondb_owner
#   DB_PASSWORD=sua_senha_neon
#   DB_SSLMODE=require

DB_HOST=localhost
DB_PORT=5444
DB_NAME=precifiq_db
DB_USER=precifiq_user
DB_PASSWORD=sua_senha_aqui
DB_SSLMODE=disable
DB_SCHEMA=controle

# --- APLICAÇÃO BACKEND ---
PORT=8081

# --- GOOGLE GEMINI AI (Módulo IA-Google) ---
# Obtenha sua chave em: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyDN0vovq2jLywkyOaXLtmhUHudCpvtdY_k

# --- GOOGLE OAUTH 2.0 (Login com Google / Google Identity Services) ---
# Obtenha seu Client ID em: https://console.cloud.google.com/apis/credentials
# Crie credenciais do tipo "ID do cliente OAuth" -> "Aplicativo da Web".
# Adicione a URL do app em Origens JavaScript autorizadas (ex: http://localhost:5173 e sua URL de produção).
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

