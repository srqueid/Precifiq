# ==============================================================================
# CONFIGURAÇÃO DE PRODUÇÃO - VPS HOSTINGER
# ==============================================================================
# Na VPS, copie este arquivo para .env:
# cp .env.production.example .env
#
# Ou no GitHub Actions, adicione este conteúdo configurado ao segredo:
# ENV_FILE_CONTENT
# ======================================east-1.aws.neon.tech
# DB_PORT=5432
# DB_NAME=neondb========================================

# ------------------------------------------------------------------------------
# OPÇÃO A: BANCO DE DADOS EXTERNO (NeonDB / Supabase / AWS RDS) - RECOMENDADO
# ------------------------------------------------------------------------------
# Se utilizar NeonDB, certifique-se de configurar:
# DB_HOST=ep-seu-endpoint.c-7.us-
# DB_USER=neondb_owner
# DB_PASSWORD=sua_senha_do_neon_aqui
# DB_SSLMODE=require
 
# ------------------------------------------------------------------------------
# OPÇÃO B: POSTGRESQL LOCAL NO DOCKER DA VPS (Profile "db")
# ------------------------------------------------------------------------------
# Se utilizar o container postgres local gerenciado pelo ./deploy-db.sh:
DB_HOST=postgres
DB_PORT=5433
DB_NAME=precifiq_db
DB_USER=precifiq_user   
DB_PASSWORD=p2QL+2Svy&3cQUaM
DB_SSLMODE=disable
DB_SCHEMA=controle

# --- APLICAÇÃO BACKEND ---
# Porta interna do container Ktor (mapeada no docker-compose e Traefik)
PORT=8081

# --- GOOGLE GEMINI AI (Módulo IA-Google) ---
# Necessária para extração automática de NF-e e previsão de estoque com IA.
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_api_producao